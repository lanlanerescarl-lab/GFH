# GFH environment settings.
# Copy this file to .env (same folder) and edit it. Never commit .env.
# Values with spaces or a # character must be wrapped in "double quotes".
# Real environment variables override anything written here.

# --- Application (used from Stage 0) -------------------------------------
# local | testing | production. Anything else is treated as production.
APP_ENV=local
# true shows the error class, message and file in the error page. Ignored in production.
APP_DEBUG=true
# Public address of the app, no trailing slash. Used to build password reset links.
APP_URL=http://localhost:8000
# debug | info | warning | error. Log file: storage/logs/app.log
LOG_LEVEL=debug

# --- Encryption key (used from Stage 1) -----------------------------------
# 32 random bytes, base64 encoded, used to encrypt organization connection strings.
# Generate one with:
#   php -r "echo 'base64:' . base64_encode(random_bytes(32)), PHP_EOL;"
# Losing this key makes every stored organization connection string unreadable.
APP_KEY=

# --- Core database (used from Stage 1) ------------------------------------
CORE_DB_HOST=127.0.0.1
CORE_DB_PORT=5432
CORE_DB_NAME=gfh_core
# Role used by web requests (limited rights).
CORE_DB_USER=gfh_core_app
CORE_DB_PASSWORD=
# Role used only by bin/migrate.php (can create and alter tables).
CORE_DB_MIGRATOR_USER=gfh_migrator
CORE_DB_MIGRATOR_PASSWORD=
# disable | allow | prefer | require. Use require for managed hosting.
CORE_DB_SSLMODE=prefer

# --- Organization databases (used from Stage 1) ---------------------------
# An organization's connection string is stored encrypted in the core registry (bin/make-org.php).
# Migrations and seeds use that stored connection unless you set a migrator URL for the organization:
# MIGRATOR_URL_<SLUG>, with the slug in capitals and hyphens written as underscores. Percent-encode
# special characters in the user name or password (@ becomes %40). Example for the slug "demo":
# MIGRATOR_URL_DEMO=postgresql://gfh_migrator:change-me@127.0.0.1:5432/gfh_org_demo?sslmode=prefer

# --- Sessions and sign-in limits (used from Stage 2) ----------------------
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# How long a one-time password reset link stays valid.
RESET_TOKEN_HOURS=24
